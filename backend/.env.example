APP_ENV=development
DATABASE_URL=sqlite:///./interview.db
CORS_ORIGINS=http://localhost:5173
# Visual and vocal delivery analysis only runs when the candidate consents per session.
ENABLE_VISUAL_ANALYSIS=false
# Optional: folder saved by finetune_goemotions.ipynb. Default: ../model-training/text/outputs/bert-goemotions-full/model
# TEXT_EMOTION_MODEL_DIR=C:/path/to/model
# Optional: faster-whisper weights for speech-to-text. Default: ../models/checkpoints/faster-whisper-base.en
# SPEECH_MODEL_DIR=C:/path/to/faster-whisper-base.en
# MAX_AUDIO_UPLOAD_MB=50
# Optional: gaze model files. Defaults: ../models/checkpoints/gaze-mpiifacegaze-resnet-simple and
# ../models/checkpoints/mediapipe/face_landmarker.task. Weights trained on MPIIFaceGaze: CC BY-NC-SA 4.0, non-commercial.
# GAZE_MODEL_DIR=C:/path/to/gaze-mpiifacegaze-resnet-simple
# FACE_LANDMARKER_PATH=C:/path/to/face_landmarker.task
# MAX_FRAME_UPLOAD_KB=1000
